{
    "info":{
        "name":"Thread Quest Smoke Test",
        "schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable":[
        {
            "key":"baseUrl",
            "value":"http://localhost:5000"
        }
    ],
    "item":[
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
        "name": "Get Threads",
        "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/threads"
        },
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                        "const body = pm.response.json();",
                        "pm.test('Threads array exists', () => {",
                        "    pm.expect(body).to.have.property('threads');",
                        "});"
                    ]
                }
            }
        ]
    },
    {
        "name": "Get Leaderboard",
        "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/leaderboard"
        },
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                        "pm.test('Responds in under 1 second', () => {",
                        "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                        "});"
                    ]
                }
            }
        ]
    },
    {
        "name": "Reports route reachable",
        "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reports"
        },
        "event": [
          {
            "listen": "test",
            "script": {
                "exec": [
                    "pm.test(\"Reports route is protected\", () => {",
                    "    pm.response.to.have.status(403);",
                    "});",
                    "pm.test(\"Reports response exists\", () => {",
                    "    const body = pm.response.json();",
                    "    pm.expect(body).to.not.be.undefined;",
                    "});",
                    "pm.test(\"Responds in under 1 second\", () => {",
                    "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                    "});"
                ]
            }
        }
    ]
}]}